# From https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the Spotify app
SPOTIFY_REDIRECT_URI=https://ha.americanglasscorporation.com/local/dashboard.html
# Optional: fixed weather location (Echo Show kiosks often can't do geolocation)
WEATHER_LAT=
WEATHER_LON=
# Optional: dim the screen at night (local hours, 24h). Empty NIGHT_START disables.
NIGHT_START=23
NIGHT_END=7
NIGHT_DIM=0.6
